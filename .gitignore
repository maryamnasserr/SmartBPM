# Local datasets and reproducible ML/simulation artifacts (see README)
/data/raw/*
/data/processed/*
/outputs/models/*
/outputs/simulations/*
!/data/raw/README.md
!/data/processed/README.md
!/outputs/models/README.md
!/outputs/simulations/README.md
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/outputs/models/.gitkeep
!/outputs/simulations/.gitkeep

# Keep documented reports/screenshots; omit transient browser artifacts
/outputs/reports/browser_checks/**/intermediate/
/outputs/reports/browser_checks/**/intermediate_attempts/
/outputs/reports/browser_checks/**/downloads/
/outputs/reports/browser_checks/**/control_downloads/

